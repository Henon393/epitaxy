# Copier ce fichier vers .env et remplacer chaque valeur par un secret fort.
# .env est ignoré par git : aucun secret ne doit être commité.
# Contrainte : pas d'apostrophe (') dans les mots de passe (injectés dans le
# script d'init SQL des rôles PostgreSQL).

# Mots de passe des rôles PostgreSQL (utilisés par docker compose à la première
# initialisation du volume).
POSTGRES_SUPER_PASSWORD=change-me
POSTGRES_MIGRATOR_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me

# Connexion de l'application : rôle app_user, SANS BYPASSRLS, non propriétaire
# des tables — la RLS s'applique donc à toutes ses requêtes.
# Port hôte 5433 : 5432 est déjà occupé par un autre projet local.
APP_DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5433/facturation

# Connexion des migrations Alembic : rôle migrator, propriétaire des tables.
MIGRATOR_DATABASE_URL=postgresql+psycopg://migrator:change-me@localhost:5433/facturation

# Connexion superutilisateur : réservée aux fixtures de test (seed des tenants).
SUPER_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5433/facturation

# Clé de signature des JWT (HS256). Obligatoire, aucun défaut dans le code.
# Générer par exemple avec : python -c "import secrets; print(secrets.token_hex(32))"
APP_JWT_SECRET=change-me

APP_REDIS_URL=redis://localhost:6379/0

# dev | test | prod
APP_ENVIRONMENT=dev

# Autorise la résolution du tenant via l'en-tête X-Tenant-Id.
# Refusé au démarrage si APP_ENVIRONMENT != dev.
# TODO(auth) : ce mécanisme disparaît à l'étape auth (tenant issu du JWT).
APP_TENANT_HEADER_ENABLED=true
